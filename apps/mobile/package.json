{
  "name": "skillbridge-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "ts:check": "tsc",
    "type-check": "npm run ts:check",
    "validate:mobile": "npx expo install --check && npx expo export --platform android",
    "lint": "eslint --config ../web/eslint.config.mjs App.tsx index.js --max-warnings=0"
  },
  "dependencies": {
    "expo": "~58.0.26",
    "expo-location": "~58.0.22",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-maps": "1.29.11"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/node": "^20.19.43",
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  }
}
