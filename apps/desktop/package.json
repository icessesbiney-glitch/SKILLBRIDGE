{
  "name": "@skillbridge/desktop",
  "version": "1.0.0",
  "private": true,
  "main": "dist/main.js",
  "homepage": "./",
  "scripts": {
    "dev": "concurrently \"npm run dev:renderer\" \"wait-on http://localhost:3000 && npm run dev:main\"",
    "dev:main": "electron .",
    "dev:renderer": "cd ../web && npm run dev",
    "build": "npm run build:renderer && npm run build:main",
    "build:renderer": "cd ../web && npm run build",
    "build:main": "tsc",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run dist -- --mac",
    "dist:win": "npm run dist -- --win",
    "dist:linux": "npm run dist -- --linux"
  },
  "dependencies": {
    "electron-squirrel-startup": "^1.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.5.0",
    "concurrently": "^8.2.2",
    "electron": "^27.0.0",
    "electron-builder": "^24.6.4",
    "typescript": "latest",
    "wait-on": "^7.0.1"
  },
  "build": {
    "appId": "com.skillbridge.app",
    "productName": "SkillBridge",
    "directories": {
      "buildResources": "assets"
    },
    "files": [
      "dist/**/*",
      "node_modules/**/*"
    ],
    "mac": {
      "target": ["dmg", "zip"],
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": ["nsis", "portable"],
      "certificateFile": null
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Productivity"
    }
  }
}
