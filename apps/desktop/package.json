  "build": {
    "appId": "com.skillbridge.app",
    "productName": "SkillBridge",
    "directories": {
      "buildResources": "assets"
    },
    "files": [
      "dist/**/*",
      "renderer/**/*",
      "node_modules/**/*",
      "assets/icon.png"
    ],
    "mac": {
      "target": ["dmg", "zip"],
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": ["nsis", "portable"],
      "certificateFile": null
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Productivity"
    }
  }
