{
  "name": "skillbridge",
  "version": "1.0.0",
  "description": "SkillBridge Global Marketplace Hub Desktop Wrapper Client",
  "main": "main.js",
  "author": {
    "name": "Joshua Biney",
    "email": "icessesbiney@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/icessesbiney-glitch/SKILLBRIDGE.git"
  },
  "scripts": {
