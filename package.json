{
    "name":  "skillbridge-root",
    "version":  "1.0.0",
    "private":  true,
    "engines":  {
                    "node":  "\u003e=22 \u003c27"
                },
    "workspaces":  [
                       "apps/web",
                       "apps/desktop",
                       "apps/mobile",
                       "packages/shared"
                   ],
    "scripts":  {
                    "build":  "turbo run build --filter=@skillbridge/web",
                    "dist:desktop:win":  "npm run dist:win --workspace=@skillbridge/desktop",
                    "dist:desktop:mac":  "npm run dist:mac --workspace=@skillbridge/desktop",
                    "dist:desktop:linux":  "npm run dist:linux --workspace=@skillbridge/desktop",
                    "dist:desktop":  "npm run dist:desktop:win",
                    "typecheck:web":  "npm run typecheck --workspace @skillbridge/web",
                    "lint:web":  "npm run lint --workspace @skillbridge/web"
                },
    "devDependencies":  {
                            "@testing-library/jest-dom":  "^7.0.1",
                            "@types/jest":  "^29.5.14",
                            "jest":  "^29.7.0",
                            "jest-environment-jsdom":  "^29.7.0",
                            "turbo":  "^2.5.0"
                        },
    "packageManager":  "npm@11.19.0",
    "allowScripts":  {
                         "electron@35.7.5":  true
                     }
}
