{
  "$schema": "https://turbo.build",
  "globalDependencies": [
    "**/.env.*local"
  ],
  "globalEnv": [
    "DODO_SECRET_KEY",
    "NEXT_PUBLIC_SUPABASE_URL",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"]
    }
  }
}
